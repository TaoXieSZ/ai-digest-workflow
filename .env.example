# LLM provider 选择（PR-A classifier 用）
# 选 anthropic / deepseek / qwen / openai
LLM_PROVIDER=deepseek

# 模型名（按 provider 不同；不设走默认）
# anthropic: claude-haiku-4-5
# deepseek: deepseek-chat
# qwen: qwen-turbo
LLM_MODEL=deepseek-chat

# API key（按 provider 选一个填）
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# 可选：覆盖 provider 默认 base URL（自部署/代理场景）
LLM_BASE_URL=

# 飞书机器人 webhook（PR-A 事件推送 + PR-B digest 推送）
# 创建：飞书群 -> 设置 -> 群机器人 -> 添加自定义机器人
FEISHU_WEBHOOK_URL=

# 静默时段（不推送）— 24h 时区 Asia/Shanghai
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# Notion API（PR-B 归档用）
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 飞书自建应用（事件雷达 → 飞书日历同步用）
# 创建：飞书开放平台 -> 开发者后台 -> 创建企业自建应用
# 权限至少需要：calendar:calendar 和 calendar:event
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 用 `python scripts/feishu_list_calendars.py --ensure-primary` 拿到 calendar_id 后填这里
FEISHU_CALENDAR_ID=
